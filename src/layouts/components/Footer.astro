---
const { lang = 'en' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-stone-200 bg-[#f4f0ea]">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-5 px-4 py-8 text-sm text-stone-600 sm:px-6 lg:flex-row lg:px-8">
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-stone-500">Thuan Nabuco</p>
      <p class="mt-2 text-xs uppercase tracking-[0.24em] text-stone-700">Software Engineer</p>
    </div>

    <div class="flex items-center gap-5 text-xs font-medium uppercase tracking-[0.18em]">
      <a href="https://github.com/thuan" target="_blank" rel="noreferrer" class="hover:text-stone-900">GitHub</a>
      <a href="mailto:thuansaraiva@proton.me" class="hover:text-stone-900">Email</a>
      <a href="https://linktr.ee/thuan" target="_blank" rel="noreferrer" class="hover:text-stone-900">Linktree</a>
    </div>
  </div>

  <div class="border-t border-stone-200 py-4">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 text-[10px] uppercase tracking-[0.2em] text-stone-500 sm:px-6 lg:px-8">
      <span>© {currentYear} Thuan Nabuco</span>
      <span>{lang === 'en' ? 'All rights reserved' : lang === 'es' ? 'Todos los derechos reservados' : 'Todos os direitos reservados'}</span>
    </div>
  </div>
</footer>
