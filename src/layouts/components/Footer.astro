---
const { lang = 'pt' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-950">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-slate-400 sm:px-6 lg:flex-row lg:px-8">
    <p>© {currentYear} Thuan. {lang === 'pt' ? 'Todos os direitos reservados.' : lang === 'en' ? 'All rights reserved.' : 'Todos los derechos reservados.'}</p>
    <div class="flex gap-4">
      <a href="https://github.com/thuan" target="_blank" rel="noreferrer" class="transition hover:text-white">GitHub</a>
      <a href="mailto:contato@thuan.dev" class="transition hover:text-white">Email</a>
    </div>
  </div>
</footer>
