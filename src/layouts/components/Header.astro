---
const { lang = 'pt' } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-[#1f2430]/10 bg-[#f5f3ef]/90 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href={lang === 'pt' ? '/' : `/${lang}/`} class="flex items-center gap-3">
      <img
        src="/logo-thuan.svg"
        alt="Logo Thuan Saraiva"
        class="h-11 w-11 rounded-xl object-cover ring-1 ring-[#1f2430]/20 shadow-sm shadow-[#1f2430]/10"
      />
      <div class="leading-none">
        <div class="text-base font-black tracking-[0.12em] text-[#1d2330]">THUAN</div>
        <div class="mt-1 text-[9px] font-medium uppercase tracking-[0.34em] text-[#4a5565]">SARAIVA</div>
      </div>
    </a>

    <div class="hidden items-center gap-7 text-sm font-medium text-[#2d3748] md:flex">
      <a href={lang === 'pt' ? '/' : `/${lang}/`} class="transition hover:text-[#111827]">Início</a>
      <a href={lang === 'pt' ? '#about' : `/${lang}/#about`} class="transition hover:text-[#111827]">Sobre</a>
      <a href={lang === 'pt' ? '#projects' : `/${lang}/#projects`} class="transition hover:text-[#111827]">Projetos</a>
      <a href={lang === 'pt' ? '#contact' : `/${lang}/#contact`} class="transition hover:text-[#111827]">Contato</a>
    </div>

    <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em]">
      <a href="/" class={lang === 'pt' ? 'text-[#1d2330]' : 'text-[#58657a]'}>PT</a>
      <span class="text-[#8a90a1]">|</span>
      <a href="/en/" class={lang === 'en' ? 'text-[#1d2330]' : 'text-[#58657a]'}>EN</a>
      <span class="text-[#8a90a1]">|</span>
      <a href="/es/" class={lang === 'es' ? 'text-[#1d2330]' : 'text-[#58657a]'}>ES</a>
    </div>
  </nav>
</header>
