---
const { lang = 'en' } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Work' },
  { href: '#contact', label: 'Contact' },
];

const toHref = (href: string) => {
  if (href === '/') {
    return lang === 'en' ? '/' : `/${lang}/`;
  }

  if (href.startsWith('#')) {
    return lang === 'en' ? `/${href}` : `/${lang}/${href}`;
  }

  return lang === 'en' ? href : `/${lang}${href}`;
};
---

<header class="sticky top-0 z-40 border-b border-stone-200/80 bg-[#f4f0ea]/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href={lang === 'en' ? '/' : `/${lang}/`} class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center border border-stone-300 bg-white text-sm font-black tracking-[0.2em] text-stone-900">
        T
      </div>
      <div class="leading-none">
        <div class="text-[10px] font-semibold uppercase tracking-[0.26em] text-stone-500">Thuan</div>
        <div class="mt-1 text-base font-black uppercase tracking-[0.16em] text-stone-900">Nabuco</div>
      </div>
    </a>

    <div class="hidden items-center gap-7 text-sm text-stone-700 md:flex">
      {links.map((link) => (
        <a href={toHref(link.href)} class="text-xs font-medium uppercase tracking-[0.22em] hover:text-stone-900">
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-600">
      <a href="/" class={lang === 'en' ? 'text-stone-900' : ''}>EN</a>
      <span class="text-stone-400">/</span>
      <a href="/es/" class={lang === 'es' ? 'text-stone-900' : ''}>ES</a>
      <span class="text-stone-400">/</span>
      <a href="/pt-br/" class={lang === 'pt-BR' ? 'text-stone-900' : ''}>PT-BR</a>
    </div>
  </nav>
</header>
