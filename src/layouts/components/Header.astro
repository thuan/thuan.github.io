---
const { lang = 'pt' } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href={lang === 'pt' ? '/' : `/${lang}/`} class="text-lg font-black tracking-wide text-white">
      Thuan
    </a>

    <div class="hidden items-center gap-6 text-sm text-slate-300 md:flex">
      <a href={lang === 'pt' ? '/' : `/${lang}/`} class="transition hover:text-white">Início</a>
      <a href={lang === 'pt' ? '#about' : `/${lang}/#about`} class="transition hover:text-white">Sobre</a>
      <a href={lang === 'pt' ? '#projects' : `/${lang}/#projects`} class="transition hover:text-white">Projetos</a>
      <a href={lang === 'pt' ? '#contact' : `/${lang}/#contact`} class="transition hover:text-white">Contato</a>
    </div>

    <div class="flex items-center gap-2 text-xs font-medium">
      <a href="/" class={lang === 'pt' ? 'text-cyan-400' : 'text-slate-400'}>PT</a>
      <a href="/en/" class={lang === 'en' ? 'text-cyan-400' : 'text-slate-400'}>EN</a>
      <a href="/es/" class={lang === 'es' ? 'text-cyan-400' : 'text-slate-400'}>ES</a>
    </div>
  </nav>
</header>
