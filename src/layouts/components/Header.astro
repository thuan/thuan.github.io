---
const { lang = 'en' } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Work' },
  { href: '/posts', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

const isLocaleRoute = (href: string) => href.startsWith('/');
const toHref = (href: string) => {
  if (href === '/') {
    return lang === 'en' ? '/' : `/${lang}/`;
  }

  if (!isLocaleRoute(href)) {
    return href;
  }

  return lang === 'en' ? href : `/${lang}${href}`;
};
---

<header class="sticky top-0 z-40 border-b border-stone-200/80 bg-[rgba(255,255,255,0.82)] backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href={lang === 'en' ? '/' : `/${lang}/`} class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center border border-stone-300 bg-white text-base font-black tracking-[0.2em] text-stone-900">
        T
      </div>
      <div class="leading-none text-stone-900">
        <div class="text-[10px] font-semibold uppercase tracking-[0.26em] text-stone-500">Thuan</div>
        <div class="mt-1 text-base font-black uppercase tracking-[0.14em]">Nabuco</div>
      </div>
    </a>

    <div class="hidden items-center gap-7 text-sm text-stone-700 md:flex">
      {links.map((link) => (
        <a href={toHref(link.href)} class="text-[10px] font-medium uppercase tracking-[0.22em] text-stone-700 hover:text-stone-900">
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <button
        type="button"
        class="theme-toggle inline-flex items-center rounded-full border border-stone-300 bg-white px-2.5 py-1.5 text-[9px] font-semibold uppercase tracking-[0.2em] text-stone-700 transition hover:border-stone-400 hover:text-stone-900"
        aria-label="Toggle color theme"
      >
        Light / Dark
      </button>

      <div class="hidden items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-600 sm:flex">
        <a href="/" class={lang === 'en' ? 'text-stone-900' : ''}>EN</a>
        <span class="text-stone-400">/</span>
        <a href="/es/" class={lang === 'es' ? 'text-stone-900' : ''}>ES</a>
        <span class="text-stone-400">/</span>
        <a href="/pt-br/" class={lang === 'pt-BR' ? 'text-stone-900' : ''}>PT-BR</a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const root = document.documentElement;
  const toggle = document.querySelector('.theme-toggle');

  function applyTheme(theme) {
    root.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }

  const savedTheme = localStorage.getItem('theme');
  const preferredTheme = savedTheme || 'light';
  applyTheme(preferredTheme);

  toggle?.addEventListener('click', () => {
    const nextTheme = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    applyTheme(nextTheme);
  });
</script>
