---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';

const { title, description, image, lang = 'en' } = Astro.props;
const gtagMeasurementId = import.meta.env.PUBLIC_GTAG_MEASUREMENT_ID;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="bg-[#f4f0ea] text-stone-900 antialiased">
    <Header lang={lang} />
    <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer lang={lang} />
    {
      gtagMeasurementId && (
        <>
          <script
            type="text/partytown"
            async
            src={'https://www.googletagmanager.com/gtag/js?id=' + gtagMeasurementId}
          />
          <script type="text/partytown" define:vars={{ gtagMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gtagMeasurementId);
          </script>
        </>
      )
    }
  </body>
</html>
