---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Thuan Nabuco" description="Contact Thuan Nabuco for software engineering, product systems, and remote opportunities." lang="en">
  <section class="py-10 md:py-14">
    <div class="mx-auto max-w-3xl">
      <p class="lattice-label mb-4">Contact</p>
      <h1 class="text-4xl font-black uppercase tracking-[-0.06em] text-stone-900 md:text-5xl">
        Let’s build something useful.
      </h1>
      <p class="mt-5 text-base leading-7 text-stone-600">
        I’m open to engineering roles, product systems work, and remote opportunities where strong software craftsmanship matters.
      </p>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <a href="mailto:thuansaraiva@proton.me" class="lattice-card p-6 transition hover:border-stone-400">
          <p class="lattice-label">Email</p>
          <p class="mt-3 text-lg font-medium text-stone-900">thuansaraiva@proton.me</p>
        </a>

        <a href="https://www.linkedin.com/in/thuan" target="_blank" rel="noreferrer" class="lattice-card p-6 transition hover:border-stone-400">
          <p class="lattice-label">LinkedIn</p>
          <p class="mt-3 text-lg font-medium text-stone-900">linkedin.com/in/thuan</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
