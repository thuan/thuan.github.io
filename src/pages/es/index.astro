---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'es';

const projects = [
  {
    title: 'Arquitectura de software',
    description: 'Soluciones escalables y mantenibles con foco en rendimiento y claridad.',
    href: '#',
    stack: ['Node', 'TypeScript', 'Arquitectura'],
  },
  {
    title: 'Productos digitales',
    description: 'Experiencias modernas centradas en usabilidad, entrega rápida y valor estratégico.',
    href: '#',
    stack: ['Astro', 'React', 'UX'],
  },
  {
    title: 'Sistemas e integraciones',
    description: 'Automatización, lógica backend sólida y conexión eficiente entre servicios.',
    href: '#',
    stack: ['API', 'SQL', 'Integración'],
  },
];
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION} lang={locale}>
  <section class="flex flex-col items-center px-2 py-10 text-center md:py-16">
    <img src="/logo-thuan.svg" alt="Logo Thuan Saraiva" class="h-52 w-52 md:h-72 md:w-72" />
    <h1 class="mt-8 text-4xl font-black uppercase tracking-[0.12em] text-[#1d2330] md:text-7xl">
      THUAN SARAIVA
    </h1>
    <p class="mt-4 text-xs font-semibold uppercase tracking-[0.38em] text-[#4d596f] md:text-sm">
      CREATIVE | TECHNOLOGY
    </p>
  </section>

  <section class="py-6 md:py-10">
    <div class="mx-auto max-w-4xl rounded-[32px] border border-[#1d2330]/10 bg-white/70 p-8 shadow-[0_22px_60px_rgba(17,24,39,0.05)]">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-[#64748b]">Sobre mí</p>
      <h2 class="mt-4 text-3xl font-black text-[#1d2330]">Desarrollador creativo con enfoque en producto y tecnología.</h2>
      <div class="mt-6 space-y-4 text-lg leading-8 text-[#374151]">
        <p>
          Soy Thuan, desarrollador enfocado en backend, arquitectura de software y experiencias digitales que combinan funcionalidad, velocidad y claridad.
        </p>
        <p>
          Construyo tecnología con estrategia, creando productos escalables, útiles y consistentes para personas y negocios.
        </p>
      </div>
    </div>
  </section>

  <section id="projects" class="py-8 md:py-12">
    <div class="mb-8 flex items-end justify-between gap-4 border-b border-[#1d2330]/10 pb-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-[#64748b]">Proyectos</p>
        <h2 class="mt-2 text-3xl font-black text-[#1d2330]">Trabajos seleccionados</h2>
      </div>
      <a href="/projects/" class="text-sm font-semibold uppercase tracking-[0.22em] text-[#1d2330] hover:text-[#475569]">
        Ver todos
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        projects.map((project) => (
          <article class="rounded-[28px] border border-[#1d2330]/10 bg-white/80 p-6 shadow-[0_20px_50px_rgba(17,24,39,0.04)]">
            <div class="mb-5 h-32 rounded-2xl bg-gradient-to-br from-[#e2e8f0] via-[#f8fafc] to-[#dbeafe]" />
            <h3 class="text-2xl font-black text-[#1d2330]">{project.title}</h3>
            <p class="mt-3 text-base leading-7 text-[#475569]">{project.description}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {project.stack.map((tag) => (
                <span class="rounded-full border border-[#1d2330]/10 bg-[#f8fafc] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#475569]">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
