---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Platform Architecture',
    description:
      'Designing resilient services, clean boundaries, and maintainable flows for fast-moving product teams.',
    stack: ['TypeScript', 'Node.js', 'Messaging', 'APIs'],
  },
  {
    title: 'Product Systems',
    description:
      'Shipping tools that connect business logic, user experience, and operational clarity into one coherent workflow.',
    stack: ['Product', 'UX', 'Automation', 'Observability'],
  },
  {
    title: 'Digital Experiences',
    description:
      'Creating polished interfaces and backend foundations that make products feel clear, fast, and trustworthy.',
    stack: ['Astro', 'React', 'Design Systems', 'Performance'],
  },
];

const services = [
  'System design',
  'Backend engineering',
  'API design',
  'Product strategy',
  'Automation',
  'Performance',
  'Architecture reviews',
  'Digital product execution',
];
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION} lang="en">
  <section class="grid gap-10 pb-10 pt-8 md:grid-cols-[1.35fr_0.65fr] md:items-end md:pt-14">
    <div>
      <p class="mb-4 text-[10px] font-semibold uppercase tracking-[0.32em] text-stone-500">
        Software engineer • builder • systems thinker
      </p>
      <h1 class="max-w-3xl text-4xl font-black uppercase tracking-[-0.06em] text-stone-900 md:text-7xl">
        I build software that feels clean, fast, and deserves trust.
      </h1>
      <p class="mt-6 max-w-xl text-base leading-7 text-stone-600 md:text-lg">
        I’m Thuan Nabuco, a software engineer focused on backend systems, product thinking, and digital experiences that connect technical depth with real-world usability.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="mailto:thuansaraiva@proton.me" class="rounded-full border border-stone-900 bg-stone-900 px-5 py-3 text-sm font-medium text-white transition hover:bg-stone-700">
          Contact
        </a>
        <a href="https://linktr.ee/thuan" target="_blank" rel="noreferrer" class="rounded-full border border-stone-300 bg-white px-5 py-3 text-sm font-medium text-stone-800 transition hover:border-stone-400">
          Connect
        </a>
      </div>
    </div>

    <div class="rounded-[28px] border border-stone-200 bg-white p-5 shadow-[0_18px_50px_rgba(28,25,23,0.04)]">
      <div class="flex items-center justify-between border-b border-stone-200 pb-3">
        <span class="text-[10px] font-semibold uppercase tracking-[0.28em] text-stone-500">Profile</span>
        <span class="text-xs font-medium text-stone-500">Available</span>
      </div>
      <div class="mt-5 space-y-5 text-sm text-stone-600">
        <div>
          <p class="text-[10px] uppercase tracking-[0.28em] text-stone-500">Based</p>
          <p class="mt-2 font-medium text-stone-800">Remote • Global</p>
        </div>
        <div>
          <p class="text-[10px] uppercase tracking-[0.28em] text-stone-500">Focus</p>
          <p class="mt-2 font-medium text-stone-800">Backend, product systems, digital execution</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-8 md:py-12">
    <div class="mb-6 flex items-center justify-between gap-4 border-b border-stone-200 pb-3">
      <p class="text-[10px] font-semibold uppercase tracking-[0.32em] text-stone-500">What I do</p>
    </div>

    <div class="grid gap-4 md:grid-cols-4">
      {services.map((service) => (
        <div class="rounded-[22px] border border-stone-200 bg-white p-5 shadow-[0_12px_24px_rgba(28,25,23,0.03)]">
          <p class="text-sm font-medium uppercase tracking-[0.2em] text-stone-700">{service}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-8 md:py-12">
    <div class="mb-6 flex items-center justify-between gap-4 border-b border-stone-200 pb-3">
      <p class="text-[10px] font-semibold uppercase tracking-[0.32em] text-stone-500">Selected work</p>
      <a href="/projects/" class="text-xs font-medium uppercase tracking-[0.22em] text-stone-700 hover:text-stone-900">
        View all
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {projects.map((project) => (
        <article class="rounded-[28px] border border-stone-200 bg-[#faf8f5] p-6 shadow-[0_18px_40px_rgba(28,25,23,0.03)]">
          <div class="mb-5 h-36 rounded-[22px] border border-stone-200 bg-[radial-gradient(circle_at_top_left,_rgba(41,37,36,0.08),_rgba(255,255,255,0.2)_40%,_rgba(41,37,36,0.02)_100%)]" />
          <h2 class="text-2xl font-semibold tracking-[-0.05em] text-stone-900">{project.title}</h2>
          <p class="mt-3 text-sm leading-7 text-stone-600">{project.description}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {project.stack.map((tag) => (
              <span class="rounded-full border border-stone-200 bg-white px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.18em] text-stone-600">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="py-8 md:py-12">
    <div class="rounded-[30px] border border-stone-200 bg-stone-900 p-8 text-stone-50 shadow-[0_22px_55px_rgba(28,25,23,0.14)] md:p-10">
      <p class="text-[10px] font-semibold uppercase tracking-[0.32em] text-stone-300">Let's build</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-black tracking-[-0.05em] md:text-5xl">
        I help teams turn complexity into products people trust.
      </h2>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="mailto:thuansaraiva@proton.me" class="rounded-full bg-white px-5 py-3 text-sm font-medium text-stone-900 transition hover:bg-stone-200">
          thuansaraiva@proton.me
        </a>
        <a href="https://github.com/thuan" target="_blank" rel="noreferrer" class="rounded-full border border-stone-700 px-5 py-3 text-sm font-medium text-stone-100 transition hover:border-stone-500 hover:bg-stone-800">
          GitHub
        </a>
        <a href="https://linktr.ee/thuan" target="_blank" rel="noreferrer" class="rounded-full border border-stone-700 px-5 py-3 text-sm font-medium text-stone-100 transition hover:border-stone-500 hover:bg-stone-800">
          Linktree
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
