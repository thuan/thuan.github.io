---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { translations } from '../i18n/strings';

const locale = 'pt';
const t = translations[locale];

const projects = [
  {
    title: 'Portfolio pessoal',
    description: 'Site moderno para apresentar projetos, artigos e contato.',
    href: '#',
  },
  {
    title: 'API de gestão',
    description: 'Backend escalável com autenticação, regras de negócio e integrações.',
    href: '#',
  },
  {
    title: 'Dashboard de dados',
    description: 'Painel analítico com foco em clareza, rapidez e visibilidade.',
    href: '#',
  },
];
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION} lang={locale}>
  <section class="grid items-center gap-10 py-10 md:grid-cols-[1.3fr_0.7fr] md:py-20">
    <div>
      <p class="mb-3 text-sm font-medium uppercase tracking-[0.22em] text-cyan-400">
        {t.hero.greeting}
      </p>
      <h1 class="max-w-xl text-4xl font-black leading-tight text-white md:text-6xl">
        {t.hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
        {t.hero.subtitle}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="#projects"
          class="rounded-full bg-cyan-400 px-6 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300"
        >
          {t.hero.ctaPrimary}
        </a>
        <a
          href="#contact"
          class="rounded-full border border-slate-700 px-6 py-3 font-semibold text-white transition hover:border-slate-500 hover:bg-slate-900"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="rounded-3xl border border-slate-800 bg-slate-900/70 p-6 shadow-2xl shadow-cyan-950/30">
      <div class="flex items-center justify-between">
        <span class="text-sm text-slate-400">Status</span>
        <span class="rounded-full bg-emerald-500/15 px-2 py-1 text-xs font-medium text-emerald-300">
          Disponível
        </span>
      </div>

      <div class="mt-8 space-y-6">
        <div>
          <p class="text-sm text-slate-400">Especialidade</p>
          <p class="mt-2 text-xl font-semibold text-white">Backend & produto digital</p>
        </div>

        <div>
          <p class="text-sm text-slate-400">Stack</p>
          <p class="mt-2 text-xl font-semibold text-white">Astro · TypeScript · Node · SQL</p>
        </div>

        <div>
          <p class="text-sm text-slate-400">Localização</p>
          <p class="mt-2 text-xl font-semibold text-white">Brasil</p>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="py-12">
    <div class="mb-6 flex items-center justify-between border-b border-slate-800 pb-4">
      <h2 class="text-2xl font-bold text-white">{t.about.title}</h2>
    </div>

    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 text-lg leading-8 text-slate-300">
      <p>{t.about.text}</p>
    </div>
  </section>

  <section id="projects" class="py-12">
    <div class="mb-6 flex items-center justify-between border-b border-slate-800 pb-4">
      <h2 class="text-2xl font-bold text-white">{t.projects.title}</h2>
      <a href="/projects/" class="text-sm text-cyan-400 hover:text-cyan-300">
        {t.projects.cta}
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        projects.map((project) => (
          <article class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 transition hover:-translate-y-1 hover:border-cyan-500/50">
            <div class="mb-4 h-36 rounded-xl bg-gradient-to-br from-cyan-500/20 to-slate-800" />
            <h3 class="text-xl font-bold text-white">{project.title}</h3>
            <p class="mt-3 text-slate-300">{project.description}</p>
            <a href={project.href} class="mt-5 inline-block text-cyan-400">Ver mais →</a>
          </article>
        ))
      }
    </div>
  </section>

  <section id="contact" class="py-12">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-8 text-center">
      <h2 class="text-3xl font-bold text-white">Vamos conversar?</h2>
      <p class="mt-4 text-slate-300">Estou aberto a oportunidades, colaborações e projetos.</p>
      <a
        href="mailto:contato@thuan.dev"
        class="mt-6 inline-block rounded-full bg-white px-6 py-3 font-semibold text-slate-950"
      >
        Contato
      </a>
    </div>
  </section>
</BaseLayout>
