---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = 'pt';

const projects = [
  {
    title: 'Arquitetura de Software',
    description: 'Soluções escaláveis, coesas e pensadas para performance e manutenção.',
    href: '#',
    stack: ['Node', 'TypeScript', 'Clean Architecture'],
  },
  {
    title: 'Painéis e Produtos Digitais',
    description: 'Experiências modernas com foco em clareza, UX e entregas de valor.',
    href: '#',
    stack: ['Astro', 'React', 'UI/UX'],
  },
  {
    title: 'Sistemas e Integrações',
    description: 'Automação, backend robusto e conectividade entre ferramentas e serviços.',
    href: '#',
    stack: ['API', 'SQL', 'Integrations'],
  },
];
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION} lang={locale}>
  <section class="flex flex-col items-center px-2 py-10 text-center md:py-16">
    <img src="/logo-thuan.svg" alt="Logo Thuan Saraiva" class="h-52 w-52 md:h-72 md:w-72" />
    <h1 class="mt-8 text-4xl font-black uppercase tracking-[0.12em] text-[#1d2330] md:text-7xl">
      THUAN SARAIVA
    </h1>
    <p class="mt-4 text-xs font-semibold uppercase tracking-[0.38em] text-[#4d596f] md:text-sm">
      CREATIVE | TECHNOLOGY
    </p>
  </section>

  <section class="py-6 md:py-10">
    <div class="mx-auto max-w-4xl rounded-[32px] border border-[#1d2330]/10 bg-white/70 p-8 shadow-[0_22px_60px_rgba(17,24,39,0.05)]">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-[#64748b]">Sobre</p>
      <h2 class="mt-4 text-3xl font-black text-[#1d2330]">Desenvolvedor criativo com foco em produto e tecnologia.</h2>
      <div class="mt-6 space-y-4 text-lg leading-8 text-[#374151]">
        <p>
          Sou Thuan, desenvolvedor com foco em backend, arquitetura de software e experiências digitais que unem funcionalidade, velocidade e clareza.
        </p>
        <p>
          Trabalho com soluções que conectam tecnologia e estratégia, criando produtos mais consistentes, escaláveis e úteis para pessoas e negócios.
        </p>
      </div>
    </div>
  </section>

  <section id="projects" class="py-8 md:py-12">
    <div class="mb-8 flex items-end justify-between gap-4 border-b border-[#1d2330]/10 pb-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-[#64748b]">Projetos</p>
        <h2 class="mt-2 text-3xl font-black text-[#1d2330]">Trabalhos selecionados</h2>
      </div>
      <a href="/projects/" class="text-sm font-semibold uppercase tracking-[0.22em] text-[#1d2330] hover:text-[#475569]">
        Ver tudo
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        projects.map((project) => (
          <article class="rounded-[28px] border border-[#1d2330]/10 bg-white/80 p-6 shadow-[0_20px_50px_rgba(17,24,39,0.04)]">
            <div class="mb-5 h-32 rounded-2xl bg-gradient-to-br from-[#e2e8f0] via-[#f8fafc] to-[#dbeafe]" />
            <h3 class="text-2xl font-black text-[#1d2330]">{project.title}</h3>
            <p class="mt-3 text-base leading-7 text-[#475569]">{project.description}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {project.stack.map((tag) => (
                <span class="rounded-full border border-[#1d2330]/10 bg-[#f8fafc] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#475569]">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="contact" class="py-10 md:py-16">
    <div class="rounded-[32px] border border-[#1d2330]/10 bg-[#1d2330] p-8 text-center text-white shadow-[0_24px_60px_rgba(17,24,39,0.12)] md:p-12">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-300">Contato</p>
      <h2 class="mt-4 text-3xl font-black md:text-5xl">Vamos criar algo com propósito.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
        Estou aberto a projetos, colaborações, oportunidades e conversas técnicas.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="mailto:contato@thuan.dev" class="rounded-full bg-white px-6 py-3 font-semibold text-[#1d2330] transition hover:bg-slate-200">
          contato@thuan.dev
        </a>
        <a href="https://github.com/thuan" target="_blank" rel="noreferrer" class="rounded-full border border-white/20 px-6 py-3 font-semibold text-white transition hover:bg-white/5">
          GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
