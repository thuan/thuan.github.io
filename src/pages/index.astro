---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  'Backend engineering',
  'System design',
  'Product thinking',
  'API design',
  'Architecture reviews',
  'Observability',
  'Automation',
  'Digital product execution',
];
---

<BaseLayout title="Thuan Nabuco — Software Engineer" description="Software engineer focused on systems, product thinking, and digital products built for real-world scale." lang="en">
  <section class="py-8 md:py-12">
    <div class="grid gap-10 md:grid-cols-[1.2fr_0.8fr] md:items-center">
      <div>
        <p class="lattice-label mb-4">Software engineer • builder • systems thinker</p>
        <h1 class="max-w-3xl text-4xl font-black uppercase tracking-[-0.06em] text-stone-900 md:text-6xl">
          I build software that helps teams move faster and trust the systems behind it.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-stone-600 md:text-lg">
          I’m Thuan Nabuco, a software engineer focused on backend systems, product thinking, and digital experiences that connect technical depth with business clarity.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="rounded-full border border-stone-900 bg-stone-900 px-5 py-3 text-sm font-medium text-white transition hover:bg-stone-700">
            Work with me
          </a>
          <a href="/projects" class="rounded-full border border-stone-300 bg-white px-5 py-3 text-sm font-medium text-stone-800 transition hover:border-stone-400 hover:bg-stone-50">
            View work
          </a>
        </div>
      </div>

      <div class="lattice-card p-6">
        <div class="flex items-center justify-between border-b border-stone-200 pb-3">
          <span class="lattice-label">Profile</span>
          <span class="text-xs font-medium text-stone-500">Available</span>
        </div>
        <div class="mt-5 space-y-5 text-sm text-stone-600">
          <div>
            <p class="lattice-label">Based</p>
            <p class="mt-2 font-medium text-stone-800">Remote • Global</p>
          </div>
          <div>
            <p class="lattice-label">Focus</p>
            <p class="mt-2 font-medium text-stone-800">Backend, product systems, digital execution</p>
          </div>
          <div>
            <p class="lattice-label">Stack</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {skills.map((skill) => (
                <span class="lattice-chip">{skill}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-8 md:py-12">
    <div class="mb-6 flex items-center justify-between gap-4 border-b border-stone-200 pb-3">
      <p class="lattice-label">What I do</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <article class="lattice-card p-5">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-stone-700">Backend</p>
        <p class="mt-3 text-sm leading-6 text-stone-600">Designing resilient APIs, services, and system boundaries that are easy to operate and evolve.</p>
      </article>
      <article class="lattice-card p-5">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-stone-700">Product</p>
        <p class="mt-3 text-sm leading-6 text-stone-600">Working closely with business goals to shape features that are technically sound and useful in practice.</p>
      </article>
      <article class="lattice-card p-5">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-stone-700">Systems</p>
        <p class="mt-3 text-sm leading-6 text-stone-600">Building scalable workflows, observability patterns, and operational clarity for growing products.</p>
      </article>
      <article class="lattice-card p-5">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-stone-700">Execution</p>
        <p class="mt-3 text-sm leading-6 text-stone-600">Translating strategy into shipped product experiences that teams can actually rely on.</p>
      </article>
    </div>
  </section>

  <section class="py-8 md:py-12">
    <div class="mb-6 flex items-center justify-between gap-4 border-b border-stone-200 pb-3">
      <p class="lattice-label">Why teams hire me</p>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      <div class="lattice-card p-6">
        <h2 class="text-xl font-semibold tracking-[-0.04em] text-stone-900">I connect systems to business value</h2>
        <p class="mt-3 text-sm leading-7 text-stone-600">I care about what the software is doing for the user and the business, not just whether the code compiles.</p>
      </div>
      <div class="lattice-card p-6">
        <h2 class="text-xl font-semibold tracking-[-0.04em] text-stone-900">I design for maintenance</h2>
        <p class="mt-3 text-sm leading-7 text-stone-600">My work aims for clarity, ownership, and long-term durability instead of brittle shortcuts.</p>
      </div>
      <div class="lattice-card p-6">
        <h2 class="text-xl font-semibold tracking-[-0.04em] text-stone-900">I work well across product and engineering</h2>
        <p class="mt-3 text-sm leading-7 text-stone-600">I can move between architecture, execution, and product decisions without losing momentum.</p>
      </div>
    </div>
  </section>
</BaseLayout>
